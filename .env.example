# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="DevResponse Enterprise"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRODUCTION_HOST="app.devresponse.com"
# informational only — NOT read at runtime; the canonical locale list/default
# live in src/config/i18n-config.ts. Editing these does NOT change behavior.
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,fr,es,uk,pt,zh,hi,ja"

# Better Auth. Min 32 chars — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Additional trusted origins (comma-separated). Shared by Better Auth's
# trustedOrigins and the administrator mutation origin guard. The app's
# own origin (NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL) is always trusted;
# add extra origins (e.g. the production host) here per deployment.
ADMIN_TRUSTED_ORIGINS="https://app.devresponse.com"

# OPTIONAL — parent domain for the session cookie (e.g. ".devresponse.com").
# Leave unset for the default host-only cookie (per-app isolation). Set it
# ONLY when running co-trusted shared-auth-schema satellites (Option C in
# docs/integration-satellite-apps.md); primary + satellites must share it.
# COOKIE_DOMAIN=""

# PostgreSQL
DATABASE_URL="postgresql://devresponse:devresponse@localhost:5444/devresponse_db"
DATABASE_TEST_URL="postgresql://devresponse:devresponse@localhost:5444/devresponse_db_test"

# Schema that ALL tables (app + Better Auth) are deployed into. Applied at the
# connection level via search_path (`<DB_SCHEMA>,public`); extensions stay in
# `public`. Default `auth`. Set a different value per deployment to isolate
# applications by schema. Must be a plain SQL identifier.
DB_SCHEMA="auth"

# How per-connection settings are applied: `search_path` (the DB_SCHEMA above)
# AND the PG_STATEMENT_TIMEOUT_MS / PG_IDLE_IN_TX_TIMEOUT_MS ceilings below. ON
# by default: all are sent as libpq STARTUP parameters, which works on a direct
# endpoint + local Postgres. A TRANSACTION-POOLING endpoint (Neon's pooled host,
# PgBouncer, Supabase's pooler) REJECTS startup parameters (`08P01 unsupported
# startup parameter in options: search_path`). To run against one, set this to
# 0 (NONE of the three is sent then) AND make them role defaults the pooler
# honors (review #20):
#   ALTER ROLE <db_role> SET search_path = "auth", public;
#   ALTER ROLE <db_role> SET statement_timeout = '30s';
#   ALTER ROLE <db_role> SET idle_in_transaction_session_timeout = '30s';
# Migrations keep it ON against the direct endpoint. See docs/configuration.md.
# DB_SEARCH_PATH_VIA_OPTIONS=0

# PostgreSQL runtime-pool sizing + timeouts (src/db/database.ts). All coerced
# to integers and bounded; a non-numeric value fails fast at boot. The two
# server-side ceilings are startup parameters and are only sent while
# DB_SEARCH_PATH_VIA_OPTIONS is on (see above).
# PGPOOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=5000          # connection acquisition timeout
# PG_STATEMENT_TIMEOUT_MS=30000       # per-statement server-side ceiling
# PG_IDLE_IN_TX_TIMEOUT_MS=30000      # idle-in-transaction server-side ceiling

# Google social login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft social login
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# GitHub social login
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Internal JWT handoff for subdomain SSO. The ISSUER is the primary's ORIGIN
# URL: consumers fetch its public keys from `${SSO_HANDOFF_ISSUER}/api/sso/jwks.json`.
SSO_HANDOFF_ISSUER="https://demo.devresponse.ca"
SSO_HANDOFF_AUDIENCE_PREFIX="devresponse-app"
# Identifier of THIS receiving application (used to build the expected
# audience as `${SSO_HANDOFF_AUDIENCE_PREFIX}:${SSO_HANDOFF_APPLICATION_ID}`).
# MUST be set per-deployment so the audience check cannot be spoofed via
# the Host header.
SSO_HANDOFF_APPLICATION_ID="portal"
# Ed25519 private JWK (JSON string) that SIGNS handoff tokens — set it ONLY on
# the issuer (the primary). Satellites leave it unset: they verify against the
# issuer's public JWKS and hold no signing material, so a compromised
# satellite can forge nothing. Optional at boot (a deployment without it can
# consume handoffs but /api/sso/launch answers 503). Keep it distinct from
# API_JWT_PRIVATE_KEY. Generate one with:
#   node -e "import('jose').then(async j=>{const {privateKey}=await j.generateKeyPair('EdDSA',{extractable:true});console.log(JSON.stringify(await j.exportJWK(privateKey)))})"
SSO_HANDOFF_PRIVATE_KEY=""
# SSO_HANDOFF_KID=""                  # optional; defaults to the JWK thumbprint
# Zero-downtime rotation: move the old key here, put the new key in
# SSO_HANDOFF_PRIVATE_KEY; the old public half stays in the JWKS until you
# remove it (tokens live <= 60s, so the overlap can be minutes).
# SSO_HANDOFF_PREVIOUS_PRIVATE_KEY=""
# SSO_HANDOFF_PREVIOUS_KID=""         # only if you pinned a fixed SSO_HANDOFF_KID
SSO_HANDOFF_TTL_SECONDS=60

# Enterprise-app origin allow-list (P2-5). The origin of a registered
# enterprise app is the redirect target for signed SSO handoff tokens, so
# admins may only register origins whose host falls under one of these
# comma-separated suffixes. Each entry MUST be a registrable domain (at least
# one label beyond its public suffix): a bare TLD (`com`) or a public-suffix
# entry (`co.uk`, `github.io`) fails boot (review #14). In PRODUCTION the var
# is effectively required — unset ⇒ no origin can be registered (fails
# closed, warned at boot). Outside production an unset value is derived from
# NEXT_PUBLIC_PRODUCTION_HOST's registrable domain (`localhost` tolerated).
# SSO_ALLOWED_ORIGIN_SUFFIXES="devresponse.com"

# Number of trusted reverse proxies / CDNs in front of the app (P2-4). The
# client IP for rate-limit keys is taken this many hops from the RIGHT of
# X-Forwarded-For, so a client cannot mint fresh buckets by spoofing the
# (leftmost) XFF value. Default 1 (one CDN/LB, e.g. Vercel). Set to your
# actual proxy depth. Also drives Better Auth's sign-in/reset limiter and
# session.ipAddress via the app-derived x-drk-client-ip header, stamped by the
# proxy AND at every server-side auth.api.* call site (review #35). The edge
# must set X-Forwarded-For (or X-Real-IP) and overwrite/strip a client-sent
# X-Real-IP — see docs/configuration.md "Reverse proxy / limits".
# TRUSTED_PROXY_COUNT=1

# Hard row cap for a single administrator CSV export (default 100000). When
# the cap is hit the export still returns the rows read so far and appends a
# `# export_truncated:` sentinel line so the UI can flag the file as partial.
# ADMIN_EXPORT_MAX_ROWS=100000

# Email delivery (specs.md §35 / docs/configuration.md).
# Outbound email is outbox-first: every email is rendered and recorded in
# `app_outbox` BEFORE any delivery attempt. With no provider configured
# (the default below) emails are recorded with status `logged` and never
# sent — the right mode for local dev and CI. Set EMAIL_PROVIDER to a
# supported provider to enable real delivery.
#
# EMAIL_PROVIDER="resend"          # "resend" | "mailgun" (unset = no delivery)
EMAIL_FROM="DevResponse <no-reply@localhost>"
#
# Resend (https://resend.com/docs/api-reference/emails/send-email):
# RESEND_API_KEY=""
#
# Mailgun (https://documentation.mailgun.com/docs/mailgun/api-reference/send/):
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN="mg.example.com"
# MAILGUN_BASE_URL="https://api.mailgun.net"   # use https://api.eu.mailgun.net for EU

# Shared secret gating the cron entrypoints under /api/internal/*: outbox-drain
# (retries `pending` outbox rows on a serverless host with no long-running
# `pnpm outbox:drain` process) and mcp-registration-reap (expires stale pending
# MCP self-registrations; see MCP_REGISTRATION_PENDING_TTL_DAYS). The scheduler
# presents it as `Authorization: Bearer <CRON_SECRET>` (Vercel Cron attaches it
# automatically when set). The route FAILS CLOSED when unset — an unconfigured
# secret means the trigger is never callable, never unauthenticated. When set
# it must be at least 32 chars (validated at boot; empty = unset):
#   openssl rand -base64 32
# CRON_SECRET=""

# Machine credentials for the RESTful API surface
# (docs/design-api-keys-and-tokens.md). Both paths ship DARK by default —
# enable per environment. API keys (drk_…) need no extra crypto material.
# JWT access tokens require an Ed25519 signing key (JSON-encoded JWK with
# the private `d` member); the public half is served at /api/v1/jwks.json.
#
# Generate an Ed25519 JWK quickly with jose:
#   node -e "import('jose').then(async j => { const {privateKey}=await j.generateKeyPair('EdDSA',{extractable:true}); console.log(JSON.stringify(await j.exportJWK(privateKey))) })"
#
# API_KEYS_ENABLED="1"
# API_KEY_ENV_TAG="live"               # "live" | "test" (stamped into drk_<tag>_…)
# API_KEY_DEFAULT_TTL_DAYS=""          # empty = keys never expire by default (UI warns)
# API_JWT_ENABLED="1"
# API_JWT_ISSUER="https://app.devresponse.com"   # defaults to BETTER_AUTH_URL
# API_JWT_AUDIENCE="devresponse-api"   # `aud` of tokens for /api/v1 (the default `resource`)
# API_JWT_PRIVATE_KEY=""               # Ed25519 private JWK as a JSON string
# API_JWT_KID=""                       # optional; defaults to the JWK thumbprint
# API_JWT_ACCESS_TTL_SECONDS="900"     # ≤ 3600
# Zero-downtime key rotation: set the OLD private JWK here while the new one is
# API_JWT_PRIVATE_KEY. Its public half stays in JWKS + verifies until tokens
# minted before the rotation expire (≤ TTL); remove it afterward.
# API_JWT_PREVIOUS_PRIVATE_KEY=""      # the prior API_JWT_PRIVATE_KEY (verify-only)
# API_JWT_PREVIOUS_KID=""              # only if you pin a fixed API_JWT_KID
#
# MCP agent gateway (docs/design-mcp-agent-gateway.md). DARK by default;
# reuses the machine-API bearer credential, so it needs API_KEYS_ENABLED
# and/or API_JWT_ENABLED to be usable.
# MCP_ENABLED="1"
# Audience binding (RFC 8707): /api/mcp accepts only JWTs minted with
# `resource=<BETTER_AUTH_URL>/api/mcp` at the token endpoint. Set this to "1"
# for a rollout window to ALSO accept legacy tokens carrying the plain v1
# audience (API_JWT_AUDIENCE); unset it once every agent requests the MCP
# resource. API keys are not audience-bound and are unaffected.
# MCP_AUDIENCE_GRACE="1"
# Agent self-registration (RFC 7591 DCR), DARK by default. `approval` (default)
# parks new agents pending admin activation; `open` activates them but they stay
# scopeless. A registration targets `organization` (a slug/id) or the default.
# MCP_REGISTRATION_ENABLED="1"
# MCP_REGISTRATION_MODE="approval"          # "approval" | "open"
# MCP_REGISTRATION_DEFAULT_ORG="default"    # used when a request omits `organization`;
#                                           # once set, other orgs are refused unless allow-listed
# MCP_REGISTRATION_ALLOWED_ORGS=""          # comma-separated slugs/ids a request may name
# MCP_REGISTRATION_MAX_PER_ORG="50"         # self-registered active clients per org; 0 = unlimited
# MCP_REGISTRATION_PENDING_TTL_DAYS="7"     # reaper expires still-pending registrations; 0 = off

# Test-only: set to "1" to disable Better Auth's built-in rate limiter
# (production mode limits /sign-in/email to 3 req / 10 s per IP, which
# the browser test suites exceed). Never set on a real deployment.
# AUTH_RATE_LIMIT_DISABLED="1"

# In-app documentation viewer (docs/configuration.md). All optional — the
# defaults serve the repo's own docs/ folder read-only.
# DOCS_SOURCE="filesystem"           # only "filesystem" is supported (Phase 1)
# DOCS_ROOT=""                       # document root; defaults to the repo docs/ folder
# HELP_ROOT=""                       # help-viewer content root; defaults to the repo help/ folder
# DOCS_ALLOW_MDX_EXECUTION=""        # "1"/"true" to evaluate author JS; OFF + ignored in Phase 1
# DOCS_INTERNAL_VISIBLE=""           # "1"/"true" to render docs marked `visibility: internal`

# Local seed user
SEED_ADMIN_EMAIL="admin@devresponse.local"
SEED_ADMIN_PASSWORD="ChangeMe-LocalOnly-123!"
SEED_DEFAULT_ORGANIZATION_SLUG="default"
# `pnpm db:seed` only escalates an admin account it created itself (or its own
# admin from an earlier run: already verified + superuser). A pre-existing
# account matching SEED_ADMIN_EMAIL that it cannot vouch for makes the seed
# REFUSE (exit 1, nothing written). Set 1 to confer the admin grants on such an
# account anyway; its password, emailVerified flag and status stay as found.
# SEED_ADMIN_ADOPT_EXISTING=""

# Optional development/testing seed (`pnpm db:seed:dev`; see
# docs/developer-onboarding.md). Loads 3 organizations × 7 users
# (superuser/orgadmin/user1..5). All accounts share this one password, so it
# refuses to run under NODE_ENV=production unless DEV_SEED_ALLOW_PROD=1, AND
# — independent of NODE_ENV — refuses any DATABASE_URL whose host is not local
# (localhost / 127.0.0.1 / ::1 / 0.0.0.0 / none) unless DEV_SEED_ALLOW_REMOTE=1
# or `--force` is given. Both checks run before a connection is opened.
# DEV_SEED_PASSWORD="DevPassword123!"
# DEV_SEED_ALLOW_REMOTE=""

# Observability — Sentry (errors + tracing + Web Vitals + masked replay).
# OPT-IN: with no DSN set, the SDK initializes as a disabled no-op, nothing
# is sent, and the build is unchanged. Enable per deployment by setting a
# DSN. Full guide: docs/observability.md.
#
# Presence of NEXT_PUBLIC_SENTRY_DSN is what ENABLES the feature (and the
# build-time source-map plugin).
# NEXT_PUBLIC_SENTRY_DSN=""        # client DSN
# SENTRY_DSN=""                    # server DSN (defaults to NEXT_PUBLIC_SENTRY_DSN)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"   # defaults to NODE_ENV
# SENTRY_ENVIRONMENT="production"               # server override (defaults to NODE_ENV)
# NEXT_PUBLIC_SENTRY_RELEASE=""    # optional release tag, e.g. the git SHA
#
# Sampling (each in [0,1]):
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"          # client tracing + Web Vitals
# SENTRY_TRACES_SAMPLE_RATE="0.1"                      # server/edge tracing
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"   # fraction of clean sessions replayed
# NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE="1"     # fraction of errored sessions replayed
#
# Source-map upload at build time (optional; without these the plugin runs
# but skips upload, so traces stay minified). Build/CI secrets only —
# NEVER expose SENTRY_AUTH_TOKEN to the client.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
#
# Prometheus metrics scrape — GET /api/metrics (Node process + business metrics
# in the text exposition format). OPT-IN and FAILS CLOSED: with no token set the
# endpoint returns 401 and exposes nothing. Set a long random secret (at least
# 32 chars, validated at boot; empty = unset) and point your scraper at it with
# `Authorization: Bearer <token>`. See docs/observability.md.
# METRICS_TOKEN=""

# Structured-logger level (src/lib/observability/logger.server.ts). One of
# fatal|error|warn|info|debug|trace|silent. Defaults to `info` (and to `silent`
# under NODE_ENV=test so the suite stays quiet).
# LOG_LEVEL="info"

# Graceful-shutdown budget in ms (src/lib/shutdown.server.ts). On SIGTERM/SIGINT
# Next's own cleanup drains HTTP (in-flight requests — and their queries —
# finish) and exits 143/130; the app's watchdog only ends the pg pool and exits
# with the same signal code if that drain overruns this budget, so a stuck
# request can never hang shutdown past it (review #24). Set the orchestrator's
# termination grace period above it. No-op on Vercel. Default 10000.
# SHUTDOWN_TIMEOUT_MS=10000

# Opt-in ("1"/"true") fail-fast on uncaughtException (review #23). Next 16
# treats uncaughtException AND unhandledRejection as non-fatal, so by default
# the process-fault handlers (src/lib/process-errors.server.ts) only log +
# capture to Sentry. Set this to have an uncaught exception exit 1 after the
# capture so the orchestrator restarts the worker. An unhandled rejection never
# exits regardless. Leave unset unless you want the classic crash-and-restart.
# PROCESS_FATAL_ON_UNCAUGHT=1

# --- Data retention (D3) -----------------------------------------------------
# `pnpm db:prune` (run on a schedule) prunes expired token revocations and
# applies these retention windows. Set either to 0 to disable that table's
# time-based prune. `app_outbox` `pending` rows (in-flight retries) are never
# pruned. Audit is a compliance record, so its default window is long.
# AUDIT_RETENTION_DAYS="365"
# OUTBOX_RETENTION_DAYS="90"
