# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="DevResponse Enterprise Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRIMARY_HOST="localhost"
NEXT_PUBLIC_PRODUCTION_HOST="app.devresponse.com"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,fr,es,uk"

# Better Auth
BETTER_AUTH_SECRET="replace-with-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Additional trusted origins (comma-separated). Shared by Better Auth's
# trustedOrigins and the administrator mutation origin guard. The app's
# own origin (NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL) is always trusted;
# add extra origins (e.g. the production host) here per deployment.
ADMIN_TRUSTED_ORIGINS="https://app.devresponse.com"

# PostgreSQL
DATABASE_URL="postgresql://devresponse:devresponse@localhost:5444/devresponse_db?schema=public"
DATABASE_TEST_URL="postgresql://devresponse:devresponse@localhost:5444/devresponse_db_test?schema=public"

# Google social login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft social login
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# GitHub social login
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Internal JWT handoff for subdomain SSO
SSO_HANDOFF_ISSUER="https://app.devresponse.com"
SSO_HANDOFF_AUDIENCE_PREFIX="devresponse-app"
# Identifier of THIS receiving application (used to build the expected
# audience as `${SSO_HANDOFF_AUDIENCE_PREFIX}:${SSO_HANDOFF_APPLICATION_ID}`).
# MUST be set per-deployment so the audience check cannot be spoofed via
# the Host header.
SSO_HANDOFF_APPLICATION_ID="portal"
SSO_HANDOFF_JWT_SECRET="replace-with-separate-strong-secret"
SSO_HANDOFF_TTL_SECONDS=60

# Email delivery (specs.md §35 / docs/setup-email.md).
# Outbound email is outbox-first: every email is rendered and recorded in
# `app_outbox` BEFORE any delivery attempt. With no provider configured
# (the default below) emails are recorded with status `logged` and never
# sent — the right mode for local dev and CI. Set EMAIL_PROVIDER to a
# supported provider to enable real delivery.
#
# EMAIL_PROVIDER="resend"          # "resend" | "mailgun" (unset = no delivery)
EMAIL_FROM="DevResponse <no-reply@localhost>"
#
# Resend (https://resend.com/docs/api-reference/emails/send-email):
# RESEND_API_KEY=""
#
# Mailgun (https://documentation.mailgun.com/docs/mailgun/api-reference/send/):
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN="mg.example.com"
# MAILGUN_BASE_URL="https://api.mailgun.net"   # use https://api.eu.mailgun.net for EU

# Machine credentials for the RESTful API surface
# (docs/design-api-keys-and-tokens.md). Both paths ship DARK by default —
# enable per environment. API keys (drk_…) need no extra crypto material.
# JWT access tokens require an Ed25519 signing key (JSON-encoded JWK with
# the private `d` member); the public half is served at /api/v1/jwks.json.
#
# Generate an Ed25519 JWK quickly with jose:
#   node -e "import('jose').then(async j => { const {privateKey}=await j.generateKeyPair('EdDSA',{extractable:true}); console.log(JSON.stringify(await j.exportJWK(privateKey))) })"
#
# API_KEYS_ENABLED="1"
# API_KEY_ENV_TAG="live"               # "live" | "test" (stamped into drk_<tag>_…)
# API_KEY_DEFAULT_TTL_DAYS=""          # empty = keys never expire by default (UI warns)
# API_JWT_ENABLED="1"
# API_JWT_ISSUER="https://app.devresponse.com"   # defaults to BETTER_AUTH_URL
# API_JWT_AUDIENCE="devresponse-api"
# API_JWT_PRIVATE_KEY=""               # Ed25519 private JWK as a JSON string
# API_JWT_KID=""                       # optional; defaults to the JWK thumbprint
# API_JWT_ACCESS_TTL_SECONDS="900"     # ≤ 3600

# Test-only: set to "1" to disable Better Auth's built-in rate limiter
# (production mode limits /sign-in/email to 3 req / 10 s per IP, which
# the browser test suites exceed). Never set on a real deployment.
# AUTH_RATE_LIMIT_DISABLED="1"

# Local seed user
SEED_ADMIN_EMAIL="admin@devresponse.local"
SEED_ADMIN_PASSWORD="ChangeMe-LocalOnly-123!"
SEED_DEFAULT_ORGANIZATION_SLUG="default"
