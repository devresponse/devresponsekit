# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="DevResponse Enterprise"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRIMARY_HOST="localhost"
NEXT_PUBLIC_PRODUCTION_HOST="app.devresponse.com"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,fr,es,uk"

# Better Auth
BETTER_AUTH_SECRET="replace-with-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Additional trusted origins (comma-separated). Shared by Better Auth's
# trustedOrigins and the administrator mutation origin guard. The app's
# own origin (NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL) is always trusted;
# add extra origins (e.g. the production host) here per deployment.
ADMIN_TRUSTED_ORIGINS="https://app.devresponse.com"

# PostgreSQL
DATABASE_URL="postgresql://devresponse:devresponse@localhost:5444/devresponse_db"
DATABASE_TEST_URL="postgresql://devresponse:devresponse@localhost:5444/devresponse_db_test"

# Schema that ALL tables (app + Better Auth) are deployed into. Applied at the
# connection level via search_path (`<DB_SCHEMA>,public`); extensions stay in
# `public`. Default `auth`. Set a different value per deployment to isolate
# applications by schema. Must be a plain SQL identifier.
DB_SCHEMA="auth"

# Google social login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft social login
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# GitHub social login
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Internal JWT handoff for subdomain SSO
SSO_HANDOFF_ISSUER="https://app.devresponse.com"
SSO_HANDOFF_AUDIENCE_PREFIX="devresponse-app"
# Identifier of THIS receiving application (used to build the expected
# audience as `${SSO_HANDOFF_AUDIENCE_PREFIX}:${SSO_HANDOFF_APPLICATION_ID}`).
# MUST be set per-deployment so the audience check cannot be spoofed via
# the Host header.
SSO_HANDOFF_APPLICATION_ID="portal"
SSO_HANDOFF_JWT_SECRET="replace-with-separate-strong-secret"
SSO_HANDOFF_TTL_SECONDS=60

# Enterprise-app origin allow-list (P2-5). The origin of a registered
# enterprise app is the redirect target for signed SSO handoff tokens, so
# admins may only register origins whose host falls under one of these
# comma-separated suffixes. Unset → derived from NEXT_PUBLIC_PRODUCTION_HOST
# (its last two labels); set explicitly for multi-part TLDs (e.g. co.uk).
# SSO_ALLOWED_ORIGIN_SUFFIXES="devresponse.com"

# Number of trusted reverse proxies / CDNs in front of the app (P2-4). The
# client IP for rate-limit keys is taken this many hops from the RIGHT of
# X-Forwarded-For, so a client cannot mint fresh buckets by spoofing the
# (leftmost) XFF value. Default 1 (one CDN/LB, e.g. Vercel). Set to your
# actual proxy depth.
# TRUSTED_PROXY_COUNT=1

# Hard row cap for a single administrator CSV export (default 100000). When
# the cap is hit the export still returns the rows read so far and appends a
# `# export_truncated:` sentinel line so the UI can flag the file as partial.
# ADMIN_EXPORT_MAX_ROWS=100000

# Email delivery (specs.md §35 / docs/setup-email.md).
# Outbound email is outbox-first: every email is rendered and recorded in
# `app_outbox` BEFORE any delivery attempt. With no provider configured
# (the default below) emails are recorded with status `logged` and never
# sent — the right mode for local dev and CI. Set EMAIL_PROVIDER to a
# supported provider to enable real delivery.
#
# EMAIL_PROVIDER="resend"          # "resend" | "mailgun" (unset = no delivery)
EMAIL_FROM="DevResponse <no-reply@localhost>"
#
# Resend (https://resend.com/docs/api-reference/emails/send-email):
# RESEND_API_KEY=""
#
# Mailgun (https://documentation.mailgun.com/docs/mailgun/api-reference/send/):
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN="mg.example.com"
# MAILGUN_BASE_URL="https://api.mailgun.net"   # use https://api.eu.mailgun.net for EU

# Machine credentials for the RESTful API surface
# (docs/design-api-keys-and-tokens.md). Both paths ship DARK by default —
# enable per environment. API keys (drk_…) need no extra crypto material.
# JWT access tokens require an Ed25519 signing key (JSON-encoded JWK with
# the private `d` member); the public half is served at /api/v1/jwks.json.
#
# Generate an Ed25519 JWK quickly with jose:
#   node -e "import('jose').then(async j => { const {privateKey}=await j.generateKeyPair('EdDSA',{extractable:true}); console.log(JSON.stringify(await j.exportJWK(privateKey))) })"
#
# API_KEYS_ENABLED="1"
# API_KEY_ENV_TAG="live"               # "live" | "test" (stamped into drk_<tag>_…)
# API_KEY_DEFAULT_TTL_DAYS=""          # empty = keys never expire by default (UI warns)
# API_JWT_ENABLED="1"
# API_JWT_ISSUER="https://app.devresponse.com"   # defaults to BETTER_AUTH_URL
# API_JWT_AUDIENCE="devresponse-api"
# API_JWT_PRIVATE_KEY=""               # Ed25519 private JWK as a JSON string
# API_JWT_KID=""                       # optional; defaults to the JWK thumbprint
# API_JWT_ACCESS_TTL_SECONDS="900"     # ≤ 3600
# Zero-downtime key rotation: set the OLD private JWK here while the new one is
# API_JWT_PRIVATE_KEY. Its public half stays in JWKS + verifies until tokens
# minted before the rotation expire (≤ TTL); remove it afterward.
# API_JWT_PREVIOUS_PRIVATE_KEY=""      # the prior API_JWT_PRIVATE_KEY (verify-only)
# API_JWT_PREVIOUS_KID=""              # only if you pin a fixed API_JWT_KID

# Test-only: set to "1" to disable Better Auth's built-in rate limiter
# (production mode limits /sign-in/email to 3 req / 10 s per IP, which
# the browser test suites exceed). Never set on a real deployment.
# AUTH_RATE_LIMIT_DISABLED="1"

# In-app documentation viewer (docs/docs-viewer.md). All optional — the
# defaults serve the repo's own docs/ folder read-only.
# DOCS_SOURCE="filesystem"           # only "filesystem" is supported (Phase 1)
# DOCS_ROOT=""                       # document root; defaults to the repo docs/ folder
# DOCS_ALLOW_MDX_EXECUTION=""        # "1"/"true" to evaluate author JS; OFF + ignored in Phase 1
# DOCS_INTERNAL_VISIBLE=""           # "1"/"true" to render docs marked `visibility: internal`

# Local seed user
SEED_ADMIN_EMAIL="admin@devresponse.local"
SEED_ADMIN_PASSWORD="ChangeMe-LocalOnly-123!"
SEED_DEFAULT_ORGANIZATION_SLUG="default"

# Optional development/testing seed (`pnpm db:seed:dev`; see
# docs/setup-guide.md). Loads 3 organizations × 7 users
# (superuser/orgadmin/user1..5). All accounts share this one password, so it
# refuses to run under NODE_ENV=production unless DEV_SEED_ALLOW_PROD=1.
# DEV_SEED_PASSWORD="DevPassword123!"

# Observability — Sentry (errors + tracing + Web Vitals + masked replay).
# OPT-IN: with no DSN set, the SDK initializes as a disabled no-op, nothing
# is sent, and the build is unchanged. Enable per deployment by setting a
# DSN. Full guide: docs/observability.md.
#
# Presence of NEXT_PUBLIC_SENTRY_DSN is what ENABLES the feature (and the
# build-time source-map plugin).
# NEXT_PUBLIC_SENTRY_DSN=""        # client DSN
# SENTRY_DSN=""                    # server DSN (defaults to NEXT_PUBLIC_SENTRY_DSN)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"   # defaults to NODE_ENV
# SENTRY_ENVIRONMENT="production"               # server override (defaults to NODE_ENV)
# NEXT_PUBLIC_SENTRY_RELEASE=""    # optional release tag, e.g. the git SHA
#
# Sampling (each in [0,1]):
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"          # client tracing + Web Vitals
# SENTRY_TRACES_SAMPLE_RATE="0.1"                      # server/edge tracing
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"   # fraction of clean sessions replayed
# NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE="1"     # fraction of errored sessions replayed
#
# Source-map upload at build time (optional; without these the plugin runs
# but skips upload, so traces stay minified). Build/CI secrets only —
# NEVER expose SENTRY_AUTH_TOKEN to the client.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
#
# Prometheus metrics scrape — GET /api/metrics (Node process + business metrics
# in the text exposition format). OPT-IN and FAILS CLOSED: with no token set the
# endpoint returns 401 and exposes nothing. Set a long random secret and point
# your scraper at it with `Authorization: Bearer <token>`. See docs/observability.md.
# METRICS_TOKEN=""

# --- Data retention (D3) -----------------------------------------------------
# `pnpm db:prune` (run on a schedule) prunes expired token revocations and
# applies these retention windows. Set either to 0 to disable that table's
# time-based prune. `app_outbox` `pending` rows (in-flight retries) are never
# pruned. Audit is a compliance record, so its default window is long.
# AUDIT_RETENTION_DAYS="365"
# OUTBOX_RETENTION_DAYS="90"
