# Use a hoisted node_modules layout. The vitest config relies on
# resolving `next/navigation` etc. from transitive dependencies
# (next-intl), which pnpm's default isolated layout breaks under the
# Node ESM resolver. Pinning the layout here keeps fresh clones
# consistent with the environment the test suite was built against.
node-linker=hoisted

# Supply-chain cooldown (review #226). A compromised package is typically
# published, exploited and unpublished/patched within hours; refusing to
# RESOLVE anything younger than 1440 minutes (24 h) means the window is over
# before we would install it. pnpm applies this only when it RESOLVES a
# version — `pnpm install`, `pnpm add`, `pnpm update`. An install from an
# existing lockfile (`--frozen-lockfile`, which is what CI, the Dockerfile and
# the deploy path all run) resolves nothing and is therefore never blocked,
# even by a Dependabot PR that pins a version published minutes ago.
# Dependabot has its own `cooldown:` in .github/dependabot.yml so it does not
# propose bumps this floor would then refuse to re-resolve.
minimum-release-age=1440
