    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "0.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "tldts": "7.4.12",
