{
  "name": "devresponsekit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Next.js 16 Holy Grail Application Shell with Better Auth, Kysely, and next-intl.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:auth:migrate": "tsx src/db/migrations/run-better-auth-migrate.ts",
    "db:auth:generate": "tsx src/db/migrations/run-better-auth-generate.ts",
    "db:app:migrate": "tsx src/db/migrations/run-migrations.ts",
    "db:seed": "tsx --conditions=react-server src/db/seeds/seed-local.ts",
    "db:seed:dev": "tsx --conditions=react-server src/db/seeds/dev-init.ts",
    "db:provision": "tsx src/db/provision.ts",
    "db:reset": "tsx src/db/reset-database.ts",
    "db:reset:reload": "tsx src/db/reset-database.ts --yes --reload",
    "db:codegen": "kysely-codegen --out-file src/db/schema/generated.ts",
    "db:prune": "tsx --conditions=react-server scripts/prune-retention.ts",
    "outbox:drain": "tsx --conditions=react-server scripts/drain-outbox.ts",
    "mcp:reap": "tsx --conditions=react-server scripts/reap-mcp-registrations.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "docs:admin-table": "tsx scripts/admin-api-table.ts",
    "sdk:admin:generate": "pnpm openapi:export && tsx scripts/verify-openapi-generator-jar.ts && pnpm exec openapi-generator-cli generate -i docs/openapi-admin.json -g typescript-fetch -o sdk/admin --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "sdk:admin:typecheck": "tsc -p sdk/admin/tsconfig.json",
    "test": "node scripts/test-shards.mjs",
    "test:serial": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run && node scripts/check-mutation-floors.mjs",
    "test:e2e": "playwright test --config=playwright.config.ts tests/e2e",
    "test:a11y": "playwright test --config=playwright.config.ts tests/accessibility",
    "test:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm test:e2e && pnpm test:a11y"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
