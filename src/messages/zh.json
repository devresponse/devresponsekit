    "features": {
      "eyebrow": "B2B 平台所需的一切",
      "title": "独立模板从不构建的生产层。",
      "subtitle": "分叉它、拥有它、发布它。DevResponseKit 整合了大多数团队需要数周才能搭建的多租户基础——并且已经过测试和文档化。",
      "items": [
        {
          "title": "管理员控制台",
          "description": "为用户、角色、30 个权限项的权限目录、组织、成员关系、企业应用、邮件和审计提供 80 多个页面——并支持服务端搜索、筛选、批量操作和 CSV 导出。"
        },
        {
          "title": "三级访问控制",
          "description": "超级管理员、组织管理员和用户三级，构建于单一可信来源的作用域原语之上。超出作用域的查询返回 404，因此一个租户永远无法得知另一个租户的存在。"
        },
        {
          "title": "作用域受限的机器 API",
          "description": "带版本的 /api/v1，使用经 SHA-256 哈希的 API 密钥和 Ed25519 JWT，并对照已发布的 JWKS 进行验证。凭据永远不能超出其所有者的权限。"
        },
        {
          "title": "跨子域单点登录",
          "description": "一次性、60 秒有效的 nonce JWT 让用户在你的各个应用之间切换而无需重新登录——并由可注册源的白名单提供支撑。"
        },
        {
          "title": "发件箱优先的邮件",
          "description": "每封邮件在投递之前都会记录在可检视、按组织限定作用域的发件箱中，配有可插拔的 Resend 和 Mailgun 提供商以及可按语言编辑的模板。"
        },
        {
          "title": "默认本地化",
          "description": "next-intl 支持四种语言，并为每位用户持久保存语言偏好——每个路由、消息和邮件模板都会遵循访客的语言。"
        },
        {
          "title": "内嵌文档查看器",
          "description": "Markdown、Mermaid 和 Shiki 通过经 XSS 加固、先净化的管线渲染——你的文档随应用一同发布。"
        },
        {
          "title": "落地交付而非纸上谈兵的安全",
          "description": "HTTP 安全标头、剔除个人身份信息的可观测性、时序安全的密钥比对，以及一项在任何路由跳过租户作用域时令构建失败的 CI 测试。"
        }
      ]
    },
    "why": {
      "eyebrow": "为什么选择 DevResponseKit",
      "title": "Clerk 和 WorkOS 级别的身份能力，以零边际成本自托管。",
      "subtitle": "组织、三级 RBAC、单点登录、API 密钥和审计全部构建于开源的 Better Auth 之上——没有按用户、按组织或按单点登录连接计费的账单随你的增长而累积。",
      "items": [
        {
          "title": "可验证的多租户隔离",
          "description": "租户隔离在构建关口强制执行：一项 CI 测试扫描每个管理路由，一旦有任何路由未使用作用域原语就访问数据便会失败。隔离从而成为一种你可以阅读和运行的保证，而非凭信任接受。"
        },
        {
          "title": "拥有代码，拥有数据",
          "description": "可复制推进的源代码，供你分叉并发布——没有框架锁定，也没有按席位的运行时费用。自托管于由你掌控的 PostgreSQL 数据库上。"
        },
        {
          "title": "经过测试和文档化",
          "description": "744 项测试，涵盖单元、组件、集成、安全、端到端和无障碍套件，外加架构决策记录和一个内嵌的文档站点。"
        }
      ]
    },
