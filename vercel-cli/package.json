{
  "name": "drk-deploy",
  "version": "1.0.0",
  "private": true,
  "description": "CLI that deploys devresponsekit to Vercel: project, environment, Postgres, migrations and promotion in the one order that is safe.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "drk-deploy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/write-build-stamp.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test --experimental-strip-types test/*.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" README.md package.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" README.md package.json"
  },
  "dependencies": {
    "@vercel/sdk": "1.28.38",
    "commander": "15.0.0",
    "vercel": "61.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "tar@7": "^7.5.21",
      "js-yaml@4": "^4.3.2",
      "minimatch@10": "^10.2.3",
      "path-to-regexp@8": "^8.4.0",
      "path-to-regexp@6": "^6.3.0",
      "smol-toml@1": "^1.7.1",
      "ajv@8": "^8.18.0",
      "@tootallnate/once@2": "^2.0.1",
      "undici": "^6.28.0"
    },
    "auditConfig": {
      "//": "Allowlist for `pnpm --dir vercel-cli audit --audit-level high`. Each muted advisory arrives only through code drk-deploy never executes — see SECURITY.md ('Dependency advisory allowlist') for the row, rationale and review-by date. Drop entries when the upstream fix lands.",
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
